# Musl development sysroot for x86_64 (amd64 / x86_64-linux-musl), Debian bookworm.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    musl-dev \
    linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

# linux-libc-dev only ships kernel UAPI headers (asm/*.h) under Debian's glibc
# multiarch triple, not the musl one our cross-GCC searches. The headers are
# libc-agnostic, so symlinking is correct, not a workaround.
RUN ln -s ../x86_64-linux-gnu/asm /usr/include/x86_64-linux-musl/asm
