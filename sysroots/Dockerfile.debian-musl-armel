# Musl development sysroot for ARM soft-float (armel / arm-linux-musleabi).
# Alpine has no linux/arm/v5 (nor arm32v5/alpine) in Docker Hub manifests; Debian bookworm does.

FROM arm32v5/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    musl-dev \
    linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

# linux-libc-dev only ships kernel UAPI headers (asm/*.h) under Debian's glibc
# multiarch triple, not the musl one our cross-GCC searches. The headers are
# libc-agnostic, so symlinking is correct, not a workaround.
RUN ln -s ../arm-linux-gnueabi/asm /usr/include/arm-linux-musleabi/asm
