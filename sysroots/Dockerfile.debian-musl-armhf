# Musl development sysroot for ARM hard-float (armhf / arm-linux-musleabihf), Debian bookworm.
# Same base series as musl-armel (arm32v*/debian:bookworm-slim) for a single musl sysroot policy.

FROM arm32v7/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    musl-dev \
    linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

# linux-libc-dev only ships kernel UAPI headers (asm/*.h) under Debian's glibc
# multiarch triple, not the musl one our cross-GCC searches. The headers are
# libc-agnostic, so symlinking is correct, not a workaround.
RUN ln -s ../arm-linux-gnueabihf/asm /usr/include/arm-linux-musleabihf/asm
