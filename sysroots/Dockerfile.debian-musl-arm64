# Musl development sysroot for AArch64 (arm64 / aarch64-linux-musl), Debian bookworm.

FROM arm64v8/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    musl-dev \
    linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

# linux-libc-dev only ships kernel UAPI headers (asm/*.h) under Debian's glibc
# multiarch triple, not the musl one our cross-GCC searches. The headers are
# libc-agnostic, so symlinking is correct, not a workaround.
RUN ln -s ../aarch64-linux-gnu/asm /usr/include/aarch64-linux-musl/asm
